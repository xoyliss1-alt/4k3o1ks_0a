import asyncpg
import os

# Render автоматически передаст ссылку на базу в эту переменную
DB_URL = os.getenv("DATABASE_URL")
pool = None

async def init_db():
    global pool
    # Создаем пул соединений
    pool = await asyncpg.create_pool(DB_URL)
    
    async with pool.acquire() as conn:
        # Таблица пользователей
        await conn.execute("""CREATE TABLE IF NOT EXISTS users (
            user_id BIGINT PRIMARY KEY,
            referrer_id BIGINT,
            balance INTEGER DEFAULT 0,
            invited_count INTEGER DEFAULT 0
        )""")
        # Таблица настроек
        await conn.execute("""CREATE TABLE IF NOT EXISTS settings (
            key TEXT PRIMARY KEY,
            value TEXT
        )""")
        # Таблица каналов
        await conn.execute("""CREATE TABLE IF NOT EXISTS channels (
            channel_id TEXT PRIMARY KEY
        )""")
        
        # Начальные настройки
        await conn.execute("INSERT INTO settings (key, value) VALUES ('reward', '10') ON CONFLICT (key) DO NOTHING")
        await conn.execute("INSERT INTO channels (channel_id) VALUES ('@voodoo_channels') ON CONFLICT (channel_id) DO NOTHING")

async def add_user(user_id: int, referrer_id: int = None):
    async with pool.acquire() as conn:
        user = await conn.fetchrow("SELECT * FROM users WHERE user_id = $1", user_id)
        if not user:
            await conn.execute("INSERT INTO users (user_id, referrer_id) VALUES ($1, $2)", user_id, referrer_id)
            if referrer_id:
                reward = await get_setting("reward")
                await conn.execute("UPDATE users SET balance = balance + $1, invited_count = invited_count + 1 WHERE user_id = $2", int(reward), referrer_id)

async def get_user(user_id: int):
    async with pool.acquire() as conn:
        row = await conn.fetchrow("SELECT * FROM users WHERE user_id = $1", user_id)
        # Возвращаем в виде кортежа для совместимости с main.py (id, referrer_id, balance, invited_count)
        return tuple(row) if row else None

async def get_all_channels():
    async with pool.acquire() as conn:
        rows = await conn.fetch("SELECT channel_id FROM channels")
        return [row['channel_id'] for row in rows]

async def add_channel(channel_id: str):
    async with pool.acquire() as conn:
        await conn.execute("INSERT INTO channels (channel_id) VALUES ($1) ON CONFLICT (channel_id) DO NOTHING", channel_id)

async def remove_channel(channel_id: str):
    if channel_id == "@voodoo_channels":
        return False
    async with pool.acquire() as conn:
        await conn.execute("DELETE FROM channels WHERE channel_id = $1", channel_id)
    return True

async def get_setting(key: str):
    async with pool.acquire() as conn:
        row = await conn.fetchrow("SELECT value FROM settings WHERE key = $1", key)
        return row['value'] if row else None

async def set_setting(key: str, value: str):
    async with pool.acquire() as conn:
        await conn.execute("UPDATE settings SET value = $1 WHERE key = $2", value, key)
